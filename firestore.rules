rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(hid) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // личные траты: видит только владелец
      match /personal/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /invites/{code} {
      allow read, create: if request.auth != null;
    }
    match /households/{hid} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow read: if isMember(hid);
      allow update: if isMember(hid) || (
        request.auth != null &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.hasAll(resource.data.members)
      );
      match /{col}/{docId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
